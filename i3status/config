general {
    colors = true
    interval = 5
}

order += "wireless _first_"
order += "memory"
order += "cpu_usage"
order += "tztime local"

wireless _first_ {
    format_up = "  %essid"
    format_down = "  down"
}

memory {
    format = " %used "
    threshold_degraded = "10%"
    format_degraded = "MEMORY LOW: %free"
}

cpu_usage {
    format = " %usage "
}

tztime local {
    format = " %d-%m-%Y  %H:%M "
}
